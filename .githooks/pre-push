#!/usr/bin/env bash
# Checks everything about to leave this computer, including commits made with the other hooks skipped.
set -euo pipefail
check="$(git rev-parse --show-toplevel)/scripts/privacy-check.sh"
zero='^0+$'
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ $local_sha =~ $zero ]] && continue
  "$check" text "the branch or tag name" "$local_ref $remote_ref"
  if [ "$(git cat-file -t "$local_sha")" = "tag" ]; then
    "$check" text "the tag" "$(git cat-file -p "$local_sha")"
  fi
  if [[ ! $remote_sha =~ $zero ]] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    "$check" history "$local_sha" "^$remote_sha"
  else
    "$check" history "$local_sha"
  fi
done
